<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DlnRenderer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DlnRenderer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Service status: playback and discovery live in the background process.  -->
        <InfoBar
            Grid.Row="0"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.ServiceText, Mode=OneWay}"
            Severity="{x:Bind ViewModel.ServiceSeverity, Mode=OneWay}" />

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Cover art from DIDL-Lite; the glyph stays visible when the control point sent none.  -->
            <Border
                Width="180"
                Height="180"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <FontIcon
                        FontSize="44"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8B8;" />
                    <Image
                        Source="{x:Bind ViewModel.CoverImage, Mode=OneWay}"
                        Stretch="UniformToFill" />
                </Grid>
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind ViewModel.StatusGlyph, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    MaxLines="2"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ArtistText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.DetailText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                <Slider
                    x:Name="PositionSlider"
                    Grid.Column="1"
                    AutomationProperties.Name="播放进度"
                    Maximum="1"
                    Minimum="0"
                    StepFrequency="0.1"
                    ValueChanged="OnPositionSliderChanged" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.Name="播放"
                    Click="OnPlayClick"
                    ToolTipService.ToolTip="播放">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                </Button>
                <Button
                    AutomationProperties.Name="暂停"
                    Click="OnPauseClick"
                    ToolTipService.ToolTip="暂停">
                    <FontIcon FontSize="14" Glyph="&#xE769;" />
                </Button>
                <Button
                    AutomationProperties.Name="停止"
                    Click="OnStopClick"
                    ToolTipService.ToolTip="停止">
                    <FontIcon FontSize="14" Glyph="&#xE71A;" />
                </Button>

                <ToggleButton
                    x:Name="MuteButton"
                    AutomationProperties.Name="静音"
                    Click="OnMuteClick"
                    IsChecked="{x:Bind ViewModel.IsMuted, Mode=OneWay}"
                    ToolTipService.ToolTip="静音 / 取消静音">
                    <FontIcon FontSize="14" Glyph="&#xE767;" />
                </ToggleButton>

                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Text="音量" />
                <Slider
                    x:Name="VolumeSlider"
                    Width="140"
                    AutomationProperties.Name="音量"
                    Maximum="100"
                    Minimum="0"
                    ValueChanged="OnVolumeSliderChanged" />
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                Severity="Error" />
        </StackPanel>
    </Grid>
</Page>

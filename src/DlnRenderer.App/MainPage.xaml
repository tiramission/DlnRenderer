<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DlnRenderer.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DlnRenderer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  The native video window is positioned over this border. XAML cannot draw on top of it.  -->
        <Border
            x:Name="VideoArea"
            Grid.Row="0"
            MinHeight="240"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon
                    FontSize="40"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE7F4;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.DetailText, Mode=OneWay}"
                    TextAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Spacing="12">
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                <Slider
                    x:Name="PositionSlider"
                    Grid.Column="1"
                    Maximum="1"
                    Minimum="0"
                    StepFrequency="0.1"
                    ValueChanged="OnPositionSliderChanged" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnOpenClick" Content="打开文件" />
                <Button
                    Click="OnPlayClick"
                    ToolTipService.ToolTip="播放">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                </Button>
                <Button
                    Click="OnPauseClick"
                    ToolTipService.ToolTip="暂停">
                    <FontIcon FontSize="14" Glyph="&#xE769;" />
                </Button>
                <Button
                    Click="OnStopClick"
                    ToolTipService.ToolTip="停止">
                    <FontIcon FontSize="14" Glyph="&#xE71A;" />
                </Button>
                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Text="音量" />
                <Slider
                    x:Name="VolumeSlider"
                    Width="140"
                    Maximum="100"
                    Minimum="0"
                    ValueChanged="OnVolumeSliderChanged" />
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                Severity="Error" />
        </StackPanel>
    </Grid>
</Page>

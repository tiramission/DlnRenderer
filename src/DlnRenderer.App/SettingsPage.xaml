<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DlnRenderer.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DlnRenderer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Windows 11 Settings layout: grouped cards of label/description rows, and a command bar pinned
        to the bottom that states whether the page has unsaved changes. The bar is outside the
        ScrollViewer on purpose - the save button must stay reachable however far the user scrolled.
    -->
    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />

        <Style x:Key="RowDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="MaxWidth" Value="560" />
        </Style>

        <Style x:Key="DividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="20,0" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!--
                Centred column: the window can be maximised, and a left-pinned 820px column leaves an
                empty half that reads as a layout bug.
            -->
            <StackPanel
                MaxWidth="820"
                Padding="32,28,32,32"
                HorizontalAlignment="Center"
                Spacing="20">

                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="更改保存在本机，后台服务与界面共用同一份配置。" />
                </StackPanel>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.Severity, Mode=OneWay}" />

                <!--
                    Discovery depends on inbound firewall rules, and no manifest capability creates
                    them: a packaged install that never ran the portable installer is discoverable by
                    nobody. This card is where that shows up and where it is repaired.
                -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Padding="20,16,20,12" Spacing="2">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="网络与发现" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="控制端要发现这台电脑，Windows 防火墙必须允许入站的 SSDP 与投屏端口。" />
                        </StackPanel>
                        <Border Style="{StaticResource DividerStyle}" />

                        <Grid Padding="20,14" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="{x:Bind ViewModel.FirewallStatusText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="{x:Bind ViewModel.FirewallDetailText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AutomationProperties.Name="重新检查防火墙"
                                    Click="OnRefreshFirewallClick"
                                    Content="重新检查"
                                    IsEnabled="{x:Bind ViewModel.CanRefreshFirewall, Mode=OneWay}" />
                                <Button
                                    AutomationProperties.Name="允许局域网发现"
                                    Click="OnAllowDiscoveryClick"
                                    Content="允许发现"
                                    IsEnabled="{x:Bind ViewModel.CanAllowDiscovery, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Device  -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Padding="20,16,20,12" Spacing="2">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="设备" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="控制端在设备列表里看到的信息。" />
                        </StackPanel>
                        <Border Style="{StaticResource DividerStyle}" />

                        <Grid Padding="20,14" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="设备名称" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="最多 64 个字符。保存后需重启后台服务才会广播新名称。" />
                            </StackPanel>
                            <TextBox
                                x:Name="DeviceNameBox"
                                Grid.Column="1"
                                Width="280"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="设备名称"
                                MaxLength="64"
                                PlaceholderText="DlnRenderer"
                                Text="{x:Bind ViewModel.DeviceName, Mode=TwoWay}"
                                TextChanged="OnDeviceNameChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Startup and window behaviour  -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Padding="20,16,20,12" Spacing="2">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="启动与窗口" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="界面如何启动、关窗之后做什么。" />
                        </StackPanel>
                        <Border Style="{StaticResource DividerStyle}" />

                        <Grid Padding="20,14" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="开机启动" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="登录 Windows 后自动打开界面，后台服务随之启动。" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="开机启动"
                                IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                OffContent="关闭"
                                OnContent="启动" />
                        </Grid>
                        <Border Style="{StaticResource DividerStyle}" />

                        <Grid Padding="20,14" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="关闭窗口时最小化到托盘" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="关闭后播放继续，可从托盘图标重新打开界面。" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="关闭窗口时最小化到托盘"
                                IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}"
                                OffContent="关闭窗口即退出界面"
                                OnContent="保留在托盘" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Where the picture goes  -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Padding="20,16,20,12" Spacing="2">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="投屏显示" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="保存后立即生效，不需要重启服务。" />
                        </StackPanel>
                        <Border Style="{StaticResource DividerStyle}" />

                        <Grid Padding="20,14" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="显示方式" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="全屏：像独立播放器一样铺满一块屏幕，界面关到托盘也能看。UI 窗口：画面嵌在主页预留的区域里，跟随窗口移动和缩放。" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="12">
                                <RadioButton
                                    AutomationProperties.Name="全屏"
                                    Content="全屏"
                                    GroupName="DisplayMode"
                                    IsChecked="{x:Bind ViewModel.IsFullscreenMode, Mode=TwoWay}" />
                                <RadioButton
                                    AutomationProperties.Name="UI 窗口"
                                    Content="UI 窗口"
                                    GroupName="DisplayMode"
                                    IsChecked="{x:Bind ViewModel.IsEmbeddedMode, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Playback  -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Padding="20,16,20,12" Spacing="2">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="播放" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="作用于后台服务的播放实例，保存后需重启服务。" />
                        </StackPanel>
                        <Border Style="{StaticResource DividerStyle}" />

                        <Grid Padding="20,14" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="播放内核" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="mpv 与 VLC 共用同一套投屏界面与控制方式。某个片源在其中一个内核上解码异常时，切换到另一个重试。" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="12">
                                <RadioButton
                                    AutomationProperties.Name="mpv 内核"
                                    Content="mpv"
                                    GroupName="PlaybackEngine"
                                    IsChecked="{x:Bind ViewModel.IsMpvEngine, Mode=TwoWay}"
                                    ToolTipService.ToolTip="libmpv：解码兼容性广，默认内核" />
                                <RadioButton
                                    AutomationProperties.Name="VLC 内核"
                                    Content="VLC"
                                    GroupName="PlaybackEngine"
                                    IsChecked="{x:Bind ViewModel.IsVlcEngine, Mode=TwoWay}"
                                    ToolTipService.ToolTip="libvlc：第二内核，个别流媒体表现更好" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource DividerStyle}" />

                        <Grid Padding="20,14" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="硬件解码" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="交给 GPU 解码以降低 CPU 占用。个别驱动上出现花屏或黑屏时，可关闭并重启服务。" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="硬件解码"
                                IsOn="{x:Bind ViewModel.HardwareDecoding, Mode=TwoWay}"
                                OffContent="软件解码"
                                OnContent="自动" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Data, diagnostics and exit  -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <StackPanel Padding="20,16,20,12" Spacing="2">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="数据与诊断" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="配置、设备标识与服务日志都在这一个目录里。" />
                        </StackPanel>
                        <Border Style="{StaticResource DividerStyle}" />

                        <Grid Padding="20,14" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="数据目录" />
                                <TextBlock
                                    Style="{StaticResource RowDescriptionStyle}"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.DataFolder}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="打开数据目录"
                                Click="OnOpenDataFolderClick"
                                Content="打开文件夹" />
                        </Grid>
                        <Border Style="{StaticResource DividerStyle}" />

                        <Grid Padding="20,14" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="版本" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}">
                                    <Run Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{x:Bind ViewModel.DeploymentText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource DividerStyle}" />

                        <Grid Padding="20,14" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="退出整个应用" />
                                <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="会同时停止后台服务，正在播放的媒体随之中断。只关闭窗口不会停止播放。" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="退出整个应用"
                                Click="OnExitClick"
                                Content="退出" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Command bar: always visible, and never claims a save that did not happen.  -->
        <Border
            Grid.Row="1"
            Padding="32,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.FooterHint, Mode=OneWay}" />

                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="重启后台服务"
                    Click="OnRestartClick"
                    Content="重启后台服务" />

                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="保存设置"
                    Click="OnSaveClick"
                    IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                        <TextBlock Text="保存" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>

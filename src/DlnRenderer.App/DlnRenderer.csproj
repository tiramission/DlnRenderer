<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DlnRenderer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Lock file for the WinUI app only. The app is always restored with a RuntimeIdentifier
      (win-x64 by default via the property below, and winapp passes -r win-x64 on top), so its
      lock file stays consistent across plain builds and 'winapp run'. The library and test
      projects are restored both with and without a RID by winapp's solution-wide restore; a RID
      in their lock files would make one of those paths fail with NU1004, so they rely on the
      exact versions pinned in Directory.Packages.props instead.
      Commit the lock file. Update it deliberately by restoring with force evaluate and reviewing
      the diff.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <!--
    The MSIX channel needs the same assets as loose files on disk, not only as PRI resources.
    WinUI resolves Assets/AppIcon.ico for the window and title-bar icons, and the tray icon loads
    it directly from AppContext.BaseDirectory - a packaged app whose install folder lacks the .ico
    silently falls back to a stock system icon. Content items are compiled into the PRI but are
    NOT copied to the publish output, which is what 'winapp package' consumes, so they are
    duplicated here as None+CopyToOutputDirectory. Publish output and package then agree.
  -->
  <ItemGroup Condition="'$(EnableMsixTooling)' == 'true'">
    <None Include="Assets\**\*.png"
          CopyToOutputDirectory="PreserveNewest"
          Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="Assets\**\*.ico"
          CopyToOutputDirectory="PreserveNewest"
          Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DlnRenderer.Core\DlnRenderer.Core.csproj" />
  </ItemGroup>

  <!--
    The MSIX package carries the renderer service as well as the UI, because the packaged app
    launches it from its own install folder - the same user-session child process the portable
    build uses (see docs/architecture.md 16.1 for why it is not a Windows service) - so the
    package needs that binary plus libmpv inside it.

    These are file copies, not a ProjectReference, for two reasons:
      1. A ProjectReference would make the App depend on the Service assembly, but the two have
         incompatible packaging settings - the win-x64 publish profile sets SelfContained=true
         for the App while the Service publishes framework-dependent - which fails the build
         with NETSDK1150.
      2. There is no code reason for the coupling: the App talks to the service over the named
         pipe and resolves its path at runtime (ServiceClient.ResolveServicePath), so it never
         needs the Service types.

    The copies land in the build output but NOT in the publish output (the WinUI packaging
    pipeline computes its own file list), which is fine: build-msix.ps1 publishes the Service
    first, then copies both files into the staging directory before 'winapp package' runs, and
    then asserts they are inside the .msix. The build-output copies keep 'winapp run' and the
    IDE's F5 working, which resolve the service next to the UI exe.
  -->
  <ItemGroup Condition="'$(EnableMsixTooling)' == 'true'">
    <None Include="..\DlnRenderer.Service\bin\$(Configuration)\net10.0-windows\win-$(Platform)\DlnRenderer.Service.exe"
          Condition="Exists('..\DlnRenderer.Service\bin\$(Configuration)\net10.0-windows\win-$(Platform)\DlnRenderer.Service.exe')"
          CopyToOutputDirectory="PreserveNewest"
          Link="DlnRenderer.Service.exe" />
  </ItemGroup>

  <!--
    Service binary and its native dependency, shipped in the package root next to the UI exe so
    ServiceClient.ResolveServicePath() finds the service beside itself without extra configuration.
  -->
  <ItemGroup>
    <None Include="..\DlnRenderer.Player\native\x64\libmpv-2.dll"
          Condition="Exists('..\DlnRenderer.Player\native\x64\libmpv-2.dll')"
          CopyToOutputDirectory="PreserveNewest"
          Link="libmpv-2.dll" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>
</Project>

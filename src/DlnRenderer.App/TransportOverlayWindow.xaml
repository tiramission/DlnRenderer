<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DlnRenderer.TransportOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        A borderless bar that floats over the video. It is a separate top-level window on purpose:
        the video is a native child window of the main window, and Windows always paints child
        windows above the XAML content of their parent - so XAML controls can never be drawn on top
        of the picture. An owned window is the only way to put our own controls there.

        Colours come from the theme, like every other card in the app: a hard-coded dark panel looked
        out of place next to the rest of the interface. The background fills the window edge to edge
        because the window itself is cut to a rounded shape with SetWindowRgn - any inset would show
        as a rectangle of window background.
    -->
    <Grid Padding="16,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="PlayPauseButton"
                Width="40"
                Height="40"
                AutomationProperties.Name="播放 / 暂停"
                Background="Transparent"
                BorderThickness="0"
                Click="OnPlayPauseClick"
                CornerRadius="20"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <FontIcon FontSize="15" Glyph="&#xE768;" />
            </Button>

            <Button
                x:Name="StopButton"
                Width="40"
                Height="40"
                AutomationProperties.Name="停止"
                Background="Transparent"
                BorderThickness="0"
                Click="OnStopClick"
                CornerRadius="20"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <FontIcon FontSize="15" Glyph="&#xE71A;" />
            </Button>

            <TextBlock
                x:Name="ElapsedText"
                Width="54"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="00:00"
                TextAlignment="Right" />

            <Slider
                x:Name="PositionSlider"
                Width="232"
                VerticalAlignment="Center"
                AutomationProperties.Name="播放进度"
                Maximum="1"
                Minimum="0"
                StepFrequency="0.1"
                ValueChanged="OnPositionChanged" />

            <TextBlock
                x:Name="TotalText"
                Width="54"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="00:00" />

            <Button
                x:Name="MuteButton"
                Width="40"
                Height="40"
                AutomationProperties.Name="静音"
                Background="Transparent"
                BorderThickness="0"
                Click="OnMuteClick"
                CornerRadius="20"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <FontIcon FontSize="15" Glyph="&#xE767;" />
            </Button>

            <Button
                x:Name="FullScreenButton"
                Width="40"
                Height="40"
                AutomationProperties.Name="全屏"
                Background="Transparent"
                BorderThickness="0"
                Click="OnFullScreenClick"
                CornerRadius="20"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                ToolTipService.ToolTip="全屏 / 退出全屏">
                <FontIcon FontSize="15" Glyph="&#xE740;" />
            </Button>
        </StackPanel>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DlnRenderer.TransportOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The transport bar that floats over the video. It is a separate top-level window on purpose:
        the video is a native child window of the main window, and Windows always paints child
        windows above the XAML content of their parent - so XAML controls can never be drawn on top
        of the picture. An owned window is the only way to put our own controls there.

        Layout mirrors a desktop video player's bottom bar: transport, a slider that takes the
        remaining width, then volume and fullscreen. Colours come from the theme like every other
        card in the app; the background fills the window edge to edge because the window itself is
        cut to a rounded shape with SetWindowRgn - any inset would show as a rectangle of window
        background.
    -->
    <Grid Padding="16,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid VerticalAlignment="Center" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="PlayPauseButton"
                Grid.Column="0"
                Width="40"
                Height="40"
                AutomationProperties.Name="播放 / 暂停"
                Background="Transparent"
                BorderThickness="0"
                Click="OnPlayPauseClick"
                CornerRadius="20"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <FontIcon FontSize="15" Glyph="&#xE768;" />
            </Button>

            <Button
                x:Name="StopButton"
                Grid.Column="1"
                Width="40"
                Height="40"
                AutomationProperties.Name="停止"
                Background="Transparent"
                BorderThickness="0"
                Click="OnStopClick"
                CornerRadius="20"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <FontIcon FontSize="15" Glyph="&#xE71A;" />
            </Button>

            <TextBlock
                x:Name="ElapsedText"
                Grid.Column="2"
                Width="54"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="00:00"
                TextAlignment="Right" />

            <Slider
                x:Name="PositionSlider"
                Grid.Column="3"
                MinWidth="120"
                VerticalAlignment="Center"
                AutomationProperties.Name="播放进度"
                Maximum="1"
                Minimum="0"
                StepFrequency="0.1"
                ValueChanged="OnPositionChanged" />

            <TextBlock
                x:Name="TotalText"
                Grid.Column="4"
                Width="54"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="00:00" />

            <Button
                x:Name="MuteButton"
                Grid.Column="5"
                Width="40"
                Height="40"
                AutomationProperties.Name="静音"
                Background="Transparent"
                BorderThickness="0"
                Click="OnMuteClick"
                CornerRadius="20"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <FontIcon FontSize="15" Glyph="&#xE767;" />
            </Button>

            <Slider
                x:Name="VolumeSlider"
                Grid.Column="6"
                Width="88"
                VerticalAlignment="Center"
                AutomationProperties.Name="音量"
                Maximum="100"
                Minimum="0"
                ValueChanged="OnVolumeChanged" />

            <TextBlock
                x:Name="EngineBadge"
                Grid.Column="7"
                Margin="8,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text=""
                Visibility="Collapsed" />

            <Button
                x:Name="FullScreenButton"
                Grid.Column="8"
                Width="40"
                Height="40"
                AutomationProperties.Name="全屏"
                Background="Transparent"
                BorderThickness="0"
                Click="OnFullScreenClick"
                CornerRadius="20"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                ToolTipService.ToolTip="全屏 / 退出全屏">
                <FontIcon FontSize="15" Glyph="&#xE740;" />
            </Button>
        </Grid>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DlnRenderer.TransportOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        A borderless bar that floats over the video. It is a separate top-level window on purpose:
        the video is a native child window of the main window, and Windows always paints child
        windows above the XAML content of their parent - so XAML controls can never be drawn on top
        of the picture. An owned window is the only way to put our own controls there.
    -->
    <Grid>
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14,8">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    x:Name="PlayPauseButton"
                    Width="36"
                    Height="36"
                    AutomationProperties.Name="播放 / 暂停"
                    Click="OnPlayPauseClick"
                    CornerRadius="18">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                </Button>

                <Button
                    x:Name="StopButton"
                    Width="36"
                    Height="36"
                    AutomationProperties.Name="停止"
                    Click="OnStopClick"
                    CornerRadius="18">
                    <FontIcon FontSize="14" Glyph="&#xE71A;" />
                </Button>

                <TextBlock
                    x:Name="ElapsedText"
                    Width="52"
                    VerticalAlignment="Center"
                    Text="00:00"
                    TextAlignment="Right" />

                <Slider
                    x:Name="PositionSlider"
                    Width="240"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="播放进度"
                    Maximum="1"
                    Minimum="0"
                    StepFrequency="0.1"
                    ValueChanged="OnPositionChanged" />

                <TextBlock
                    x:Name="TotalText"
                    Width="52"
                    VerticalAlignment="Center"
                    Text="00:00" />

                <Button
                    x:Name="MuteButton"
                    Width="36"
                    Height="36"
                    AutomationProperties.Name="静音"
                    Click="OnMuteClick"
                    CornerRadius="18">
                    <FontIcon FontSize="14" Glyph="&#xE767;" />
                </Button>

                <Button
                    x:Name="FullScreenButton"
                    Width="36"
                    Height="36"
                    AutomationProperties.Name="全屏"
                    Click="OnFullScreenClick"
                    CornerRadius="18"
                    ToolTipService.ToolTip="全屏 / 退出全屏">
                    <FontIcon FontSize="14" Glyph="&#xE740;" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

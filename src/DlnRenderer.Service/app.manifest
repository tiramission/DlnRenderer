<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="DlnRenderer.Service" />

  <!--
    DPI awareness has to be declared, not requested at runtime. The service sizes its fullscreen
    overlay from the monitor rectangles reported by Win32; a non-aware process is given virtualised
    coordinates (a 2560x1440 display at 150% reports 1707x960), so the window covered only two
    thirds of the screen. Windows also refuses SetProcessDpiAwarenessContext once .NET startup has
    created any window, so the manifest is the only reliable place for this.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- Long paths are irrelevant here, but declaring the supported OS set keeps Windows from
           applying compatibility shims to a fresh executable. -->
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>

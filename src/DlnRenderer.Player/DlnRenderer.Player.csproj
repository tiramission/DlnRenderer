<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DlnRenderer.Player</RootNamespace>
    <!-- The Win32 video host uses plain P/Invoke, so no WinUI dependency is required here. -->
  </PropertyGroup>

  <!--
    VideoLAN.LibVLC.Windows ships x86, x64 and arm64 plugin trees and enables every architecture the
    platform maps to - AnyCPU would copy all three (~450 MB) into every output folder. The service
    publishes win-x64 only, so the other two are pinned off: the package still restores once, the
    output just stops carrying binaries nothing can load.
  -->
  <PropertyGroup>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DlnRenderer.Core\DlnRenderer.Core.csproj" />
  </ItemGroup>

  <!--
    The second playback engine. LibVLCSharp is the official VideoLAN .NET binding (LGPL-2.1-or-later,
    maintained by the libvlc team); VideoLAN.LibVLC.Windows ships native libvlc.dll/libvlccore.dll
    plus the plugin tree into <output>\libvlc\win-x64, where LibVLCSharp's Core.Initialize() finds
    them. The project is GPL-2.0-or-later (docs/architecture.md §17.1), so linking an LGPL library
    and shipping its binaries is the license-compliant form; docs/licenses.md records both packages.
  -->
  <ItemGroup>
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>

  <!--
    libmpv is a native DLL and is NOT vendored in this repository: it is a 116 MiB GPL-2.0-or-later
    binary, and the project ships it in distributions rather than in git. The licensing decision
    is made (docs/architecture.md §17.1): the project is GPL-2.0-or-later too, so shipping the DLL
    is what the license expects, and THIRD-PARTY-NOTICES.md tells recipients what they got.
    scripts/fetch-libmpv.ps1 copies a verified build into this folder; the warning below is the
    reminder for a checkout that has not run it yet, not a licensing caveat.
  -->
  <ItemGroup>
    <None Include="native\x64\libmpv-2.dll"
          Condition="Exists('native\x64\libmpv-2.dll')"
          CopyToOutputDirectory="PreserveNewest"
          Link="libmpv-2.dll" />
  </ItemGroup>

  <!--
    This must stay a warning, never an error: a checkout without the DLL still builds every
    project, it just cannot play. CI runs the fetch script, so the warning does not appear there -
    which is why a warning in a CI log means the fetch step stopped working and needs looking at.
  -->
  <Target Name="WarnWhenLibmpvMissing" BeforeTargets="Build" Condition="!Exists('native\x64\libmpv-2.dll')">
    <Warning Text="libmpv-2.dll is missing from src/DlnRenderer.Player/native/x64. Build succeeds, but playback will fail at runtime. Run scripts/fetch-libmpv.ps1 (add -Download if there is no local Scoop mpv-dev)." />
  </Target>

</Project>
